rules_version = '2';

// The site and the admin portal both talk to Firestore straight from the
// browser, so these rules are the only thing standing between the database
// and the open internet. Everything is denied unless it matches a case below.
service cloud.firestore {
  match /databases/{database}/documents {

    // Contact form submissions.
    // Anyone may create one. Only the admin account may read them back, and
    // nobody may edit or delete through the client.
    match /contacts/{id} {
      allow create: if isWellFormedContact();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Per-day traffic aggregates: view count, unique count and a per-source
    // tally. Counters only — no IP, no user agent, no visitor identifier — so
    // these stay world-readable for the nightly report, which reads them over
    // the REST API without a service account.
    match /stats/{day} {
      allow read: if true;
      allow create: if isStatsShape() && request.resource.data.views == 1;
      allow update: if isStatsShape()
                    && request.resource.data.views == resource.data.views + 1;
      allow delete: if false;
    }

    // Contact submissions per day, kept separate so its counter and the view
    // counter can each have a single-increment rule of their own.
    match /contactStats/{day} {
      allow read: if true;
      allow create: if onlyKey('count') && request.resource.data.count == 1;
      allow update: if onlyKey('count')
                    && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // Lifetime per-project view counters, shown on the project cards.
    match /views/{slug} {
      allow read: if true;
      allow create: if onlyKey('count') && request.resource.data.count == 1;
      allow update: if onlyKey('count')
                    && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // Per-day, per-project engagement and scroll depth. Nested counter maps
    // can't be validated field by field in rules, so these are shape-checked
    // and left append-only.
    match /projectStats/{day} {
      allow read: if true;
      allow write: if onlyKey('projects') && request.resource.data.projects is map;
    }

    match /depthStats/{day} {
      allow read: if true;
      allow write: if onlyKey('depth') && request.resource.data.depth is map;
    }

    // Write-once markers proving a fingerprint has been counted for a given
    // day. Create is allowed and every other operation is refused, which is
    // what lets the client learn "already counted?" from a failed write
    // without ever being able to read the set back. Nothing but a literal 1
    // is stored against the key.
    match /visitorDays/{id} {
      allow create: if onlyKey('t') && request.resource.data.t == 1;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isAdmin() {
  return request.auth != null
    && request.auth.token.email_verified == true
    && request.auth.token.email.lower() == 'shehryarraza320@gmail.com';
}

function onlyKey(k) {
  return request.resource.data.keys().hasOnly([k]);
}

function isStatsShape() {
  let d = request.resource.data;
  return d.keys().hasOnly(['views', 'uniques', 'sources'])
    && d.views is int && d.views > 0
    && (!('uniques' in d) || d.uniques is int)
    && (!('sources' in d) || d.sources is map);
}

function isWellFormedContact() {
  let d = request.resource.data;
  return d.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
    && d.name is string && d.name.size() > 0 && d.name.size() <= 100
    && d.email is string && d.email.size() > 3 && d.email.size() <= 200
    && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
    && d.message is string && d.message.size() > 0 && d.message.size() <= 4000
    && d.createdAt == request.time;
}
